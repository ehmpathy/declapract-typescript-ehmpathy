// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`provision.yml — merge-by-job fix, end to end (#685) given: [case1] an rds service whose provision.yml is a pre-oidc caller with a repo-own job when: [t0] declapract apply then: before + after match snapshot: provision.yml — after merge 1`] = `
"name: provision

on:
  push:
    tags:
      - v*
    branches:
      - "main"
      - "master"
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * *" # the repo's own nightly drift plan, which the practice never declares

concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }} # per [workflow] x [branch, tag]
  cancel-in-progress: true #  cancel workflows for non-latest commits

permissions:
  id-token: write # required for oidc; a called workflow cannot exceed its caller's grant
  contents: read

jobs:
  aws-test-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/test
      github-environment-plan: preparation
      github-environment-apply: preparation
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}

  aws-prep-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prep
      github-environment-plan: preparation
      github-environment-apply: preparation
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}

  aws-prod-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prod
      github-environment-plan: production-on-else-plan
      github-environment-apply: \${{ (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')) && 'production-on-main' || 'production-on-else-apply' }} # main/tag => on-main; else => on-else-apply (actor_id-gated writer)
      allow-apply: \${{ startsWith(github.ref, 'refs/tags/') }} # only apply to prod on tags
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_PLAN_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_APPLY_ROLE_ARN }}

  github:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/github.repo/resources.ts
      scope: github
      access: prod # github repo settings are inherently a prod resource
      github-environment-plan: production-on-else-plan
      github-environment-apply: \${{ (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')) && 'production-on-main' || 'production-on-else-apply' }} # main/tag => on-main; else => on-else-apply
      creds-github-app-owner: \${{ github.repository_owner }}
      creds-github-app-id: \${{ vars.DECLASTRUCT_GITHUB_CONFORMER_APP_ID }}
    secrets:
      creds-github-app-private-key: \${{ secrets.DECLASTRUCT_GITHUB_CONFORMER_APP_PRIVATE_KEY }}

  sql-schema-prep:
    uses: ./.github/workflows/.sql-schema-control.yml
    with:
      access: prep
      github-environment-plan: preparation
      github-environment-apply: preparation
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}

  sql-schema-prod:
    uses: ./.github/workflows/.sql-schema-control.yml
    with:
      access: prod
      github-environment-plan: production-on-else-plan
      github-environment-apply: \${{ (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')) && 'production-on-main' || 'production-on-else-apply' }} # main/tag => on-main; else => on-else-apply (actor_id-gated writer)
      allow-apply: \${{ startsWith(github.ref, 'refs/tags/') }} # only apply to prod on tags
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_PLAN_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_APPLY_ROLE_ARN }}

  aws-prep-declastruct:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/aws/resources.ts
      scope: aws
      access: prep
      github-environment-plan: preparation
      github-environment-apply: preparation
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PREP_OIDC_ROLE_ARN }}

  aws-prod-declastruct:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/aws/resources.ts
      scope: aws
      access: prod
      github-environment-plan: production-on-else-plan
      github-environment-apply: \${{ (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')) && 'production-on-main' || 'production-on-else-apply' }} # main/tag => on-main; else => on-else-apply (actor_id-gated writer)
      allow-apply: \${{ startsWith(github.ref, 'refs/tags/') }} # only apply to prod on tags
      creds-aws-region: us-east-1
      creds-aws-role-arn-plan: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_PLAN_ROLE_ARN }}
      creds-aws-role-arn-apply: \${{ vars.CREDS_CICD_AWS_PROD_OIDC_APPLY_ROLE_ARN }}

  # the repo's own job, which the practice never declares
  seed-prep-fixtures:
    uses: ./.github/workflows/.seed.yml
    with:
      target: prep
"
`;

exports[`provision.yml — merge-by-job fix, end to end (#685) given: [case1] an rds service whose provision.yml is a pre-oidc caller with a repo-own job when: [t0] declapract apply then: before + after match snapshot: provision.yml — before (pre-oidc) 1`] = `
"name: provision

on:
  push:
    tags:
      - v*
    branches:
      - "main"
      - "master"
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * *" # the repo's own nightly drift plan, which the practice never declares

concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }} # per [workflow] x [branch, tag]
  cancel-in-progress: true #  cancel workflows for non-latest commits

jobs:
  aws-test-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/test
      github-environment: test
      aws-account-id: "123456789012"
    secrets:
      aws-access-key-id: \${{ secrets.TEST_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.TEST_AWS_SECRET_ACCESS_KEY }}

  aws-prep-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prep
      github-environment: prep
      aws-account-id: "123456789012"
    secrets:
      aws-access-key-id: \${{ secrets.PREP_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PREP_AWS_SECRET_ACCESS_KEY }}

  aws-prod-terraform:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prod
      github-environment: prod
      aws-account-id: "123456789012"
      allow-apply: \${{ startsWith(github.ref, 'refs/tags/') }} # only apply to prod on tags
    secrets:
      aws-access-key-id: \${{ secrets.PROD_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PROD_AWS_SECRET_ACCESS_KEY }}

  github:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/github.repo/resources.ts
      scope: github
      access: prod # github repo settings are inherently a prod resource
      creds-github-app-owner: \${{ github.repository_owner }}
      creds-github-app-id: \${{ vars.DECLASTRUCT_GITHUB_CONFORMER_APP_ID }}
    secrets:
      creds-github-app-private-key: \${{ secrets.DECLASTRUCT_GITHUB_CONFORMER_APP_PRIVATE_KEY }}

  sql-schema-prep:
    uses: ./.github/workflows/.sql-schema-control.yml
    with:
      github-environment: prep
      aws-account-id: "123456789012"
    secrets:
      aws-access-key-id: \${{ secrets.PREP_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PREP_AWS_SECRET_ACCESS_KEY }}

  sql-schema-prod:
    uses: ./.github/workflows/.sql-schema-control.yml
    with:
      github-environment: prod
      aws-account-id: "123456789012"
      allow-apply: \${{ startsWith(github.ref, 'refs/tags/') }} # only apply to prod on tags
    secrets:
      aws-access-key-id: \${{ secrets.PROD_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PROD_AWS_SECRET_ACCESS_KEY }}

  aws-prep-declastruct:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/aws/resources.ts
      scope: aws
      access: prep
      github-environment: prep
    secrets:
      aws-access-key-id: \${{ secrets.PREP_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PREP_AWS_SECRET_ACCESS_KEY }}

  aws-prod-declastruct:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/aws/resources.ts
      scope: aws
      access: prod
      github-environment: prod
    secrets:
      aws-access-key-id: \${{ secrets.PROD_AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: \${{ secrets.PROD_AWS_SECRET_ACCESS_KEY }}

  # the repo's own job, which the practice never declares
  seed-prep-fixtures:
    uses: ./.github/workflows/.seed.yml
    with:
      target: prep
"
`;
