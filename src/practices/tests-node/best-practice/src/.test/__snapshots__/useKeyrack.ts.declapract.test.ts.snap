exports[`exportAwsCredentialsFromSsoProfile given: [case1] the aws cli fails (a stale or absent sso login) when: [t0] the export runs against the failed cli then: the user-faced message matches snapshot: credential-export failure message 1`] = `"✋ ConstraintError: failed to export aws credentials from sso profile 'my-sso-profile'. run: aws sso login --profile my-sso-profile"`;

exports[`exportAwsCredentialsFromSsoProfile given: [case2] the aws cli returns a valid env-format credential block when: [t0] the export runs against the valid cli then: the parsed record matches snapshot: credential-export all-clear record 1`] = `
{
  "AWS_ACCESS_KEY_ID": "AKIAEXAMPLE",
  "AWS_SECRET_ACCESS_KEY": "secretExampleValue",
  "AWS_SESSION_TOKEN": "sessionExampleToken",
}
`;

exports[`getOneKeyrackEnvForAcceptance given: [case3] neither ACCESS nor LOCALLY, outside ci then: the message names the fix: acceptance access absent message 1`] = `"✋ ConstraintError: no ACCESS set for a cloud acceptance run. set ACCESS=prep|prod for a cloud acceptance run, or LOCALLY=true for an in-process run."`;
