exports[`persist-with-rds config validates against config.schema.ts (#638, #683, #519) given: [case2] a repo with hand-set values and legacy string tunnel fields when: [t0] the configs and the schema are applied, then applied again then: before and after match snapshot: config/prep.json — after 1`] = `
"{
  "@declapract:review": "explicit aws::param paths: copy each value to the derived name /{org}/{project}/{config}/{keyPath}, then swap the explicit path for the bare placeholder (declapract-typescript-ehmpathy#544, see provision/aws/readme.md)",
  "organization": "test-org",
  "project": "test-project",
  "environment": {
    "access": "prep"
  },
  "aws": {
    "account": "111111111111",
    "namespace": "testns"
  },
  "featureFlags": {
    "surfReport": true
  },
  "database": {
    "target": {
      "database": "testdb",
      "schema": "testdb"
    },
    "pool": {
      "max": 3
    },
    "role": {
      "cicd": {
        "for-plan": {
          "username": "cicd_user",
          "password": "$.at(aws::param/test-org/test-project/prep/legacy.plan)"
        },
        "for-apply": {
          "username": "cicd_user",
          "password": "$.at(aws::param)"
        }
      },
      "crud": {
        "username": "service_user",
        "password": "__CHANG3_ME__"
      }
    },
    "tunnel": {
      "bastion": {
        "exid": "vpc-main-bastion"
      },
      "cluster": {
        "name": "hand-set-cluster"
      },
      "local": {
        "host": "localhost",
        "port": 15432
      },
      "lambda": {
        "host": "awesomesdb.cluster-abc123.us-east-1.rds.amazonaws.com",
        "port": 5432
      }
    }
  }
}
"
`;

