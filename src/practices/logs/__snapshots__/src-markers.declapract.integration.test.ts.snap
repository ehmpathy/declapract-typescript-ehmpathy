  logic: T,
  options: { name: string; durationReportingThresholdInSeconds: number },
): T => {
  return (async (...args: any[]) => {
    log.debug(\`\${options.name}.input\`, { args });
    const result = await logic(...args);
    log.debug(\`\${options.name}.output\`, { result });
    return result;
  }) as T;
};
"
`;

