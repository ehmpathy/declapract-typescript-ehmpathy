{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "incremental": false,
    "paths": {
      "@/src/*": ["./src/*"] // the `@/` alias, narrowed to a target inside rootDir, so tsc-alias rewrites it in dist
    }
  },
  "include": [
    "src/**/*.ts",
    "nontyped_modules/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts", // all explicitly .test files are dev only assets too
    "**/*.test.js",
    "**/.test/**/*",
    "**/.scratch/**/*",
    "**/__test*__/**/*" // legacy dunder test dirs; new test assets live under .test
  ]
}
