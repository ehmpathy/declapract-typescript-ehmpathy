// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`divergent-stage guard — the shipped templates cannot re-split the stage/access axis given: [case4] the deploy-command ACCESS fall-through when: [t0] every deploy command that derives SLS_STAGE is read then: the shipped deploy commands match snapshot (a reworded message reddens): serverless deploy commands 1`] = `
{
  "deploy": "if [ "\${ACCESS:-}" = 'prod' ]; then npm run deploy:prod; elif [ "\${ACCESS:-}" = 'prep' ]; then npm run deploy:prep; else echo '🛑 invalid ACCESS, must be prod or prep' && exit 2; fi",
  "deploy:assure:committed": "if [ -n "$(git status --porcelain)" ]; then echo '🛑 uncommitted changes: deploy ships the committed tree only, so COMMIT names the code that runs; commit or stash, then retry' && git status --short && exit 2; fi",
  "deploy:prep": "ACCESS=prep npm run deploy:release",
  "deploy:prod": "ACCESS=prod npm run deploy:release:ancient && npm run deploy:send-notification",
  "deploy:prune": "if [ "\${ACCESS:-}" != 'prep' ] && [ "\${ACCESS:-}" != 'prod' ]; then echo '🛑 invalid ACCESS, must be prod or prep' && exit 2; fi && export COMMIT=$(sdk-environment get commit) && export SLS_STAGE=$([ "\${ACCESS:-}" = 'prep' ] && echo 'dev' || echo "\${ACCESS:-}") && sls prune -n 7 --stage "\${SLS_STAGE:-}" && if [ "\${ACCESS:-}" = 'prep' ]; then sls prune -n 7 --stage prep; fi",
  "deploy:release": "npm run deploy:release:ancient && npm run deploy:release:contemp",
  "deploy:release:ancient": "if [ "\${ACCESS:-}" != 'prep' ] && [ "\${ACCESS:-}" != 'prod' ]; then echo '🛑 invalid ACCESS, must be prod or prep' && exit 2; fi && npm run deploy:assure:committed && export COMMIT=$(sdk-environment get commit) && export SLS_STAGE=$([ "\${ACCESS:-}" = 'prep' ] && echo 'dev' || echo "\${ACCESS:-}") && npm run build && npm run test:runtime && sls deploy --verbose --stage "\${SLS_STAGE:-}"",
  "deploy:release:contemp": "export COMMIT=$(sdk-environment get commit) && if [ "\${ACCESS:-}" = 'prep' ]; then sls deploy --verbose --stage prep; else echo '🛑 skip contemp dual-publish: ACCESS is not prep (contemp publishes the -prep- fleet only)'; fi",
  "deploy:send-notification": "curl -X POST -H 'Content-type: application/json' --data "{\\"text\\":\\"$([ -z "\${DEPLOYER_NAME:-}" ] && git config user.name || echo "\${DEPLOYER_NAME:-}") has deployed $npm_package_name@v$npm_package_version:
https://github.com/@declapract{variable.organizationName}/$npm_package_name/tree/v$npm_package_version\\"}" @declapract{variable.slackWebhookUrl}",
  "test:runtime": "docker info > /dev/null 2>&1 || { echo '🛑 docker absent: test:runtime loads the built artifact on the deploy runtime, in the lambda image; start the docker daemon, then retry' && exit 2; } && LAMBDA_NODE_MAJOR=$(node -p "require('fs').readFileSync('serverless.yml', 'utf8').match(/runtime: nodejs([0-9]+)[.]x/)[1]") && docker run --rm -e ACCESS -e COMMIT -v "$PWD/.artifact/contents:/var/task:ro" -w /var/task --entrypoint node public.ecr.aws/lambda/nodejs:\${LAMBDA_NODE_MAJOR} -e 'const fs = require("fs"), p = require("path"); const walk = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(p.join(d, e.name)) : e.name.endsWith(".js") ? [p.join(d, e.name)] : [])); const files = walk("dist/contract/handlers"); if (!files.length) throw new Error("no handlers in dist/contract/handlers"); files.forEach((f) => require(p.join(process.cwd(), f))); console.log("✔ " + files.length + " handlers load on node " + process.versions.node);'",
}
`;
