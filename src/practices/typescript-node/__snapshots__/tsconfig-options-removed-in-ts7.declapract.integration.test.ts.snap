exports[`typescript-node tsconfig options removed in typescript 7 given: [case1] a repo on the prior template, with an alias of its own beside the template paths when: [t0] the practice is applied twice then: the removed options leave, the template paths replace the repo paths, and types lands: tsconfig.json — after 1`] = `
"{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node20/tsconfig.json"
  ],
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "dist",
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "jest"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "incremental": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    ".agent/.cache",
    "dist",
    "coverage",
    "node_modules"
  ]
}
"
`;

exports[`typescript-node tsconfig options removed in typescript 7 given: [case1] a repo on the prior template, with an alias of its own beside the template paths when: [t0] the practice is applied twice then: the removed options leave, the template paths replace the repo paths, and types lands: tsconfig.json — before 1`] = `
"{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node20/tsconfig.json"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@src/*": ["src/*"],
      "@vendor/*": ["vendor/*"] // an alias this repo added beside the template's
    },
    "importsNotUsedAsValues": "remove",
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "dist",
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16"
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
"
`;

