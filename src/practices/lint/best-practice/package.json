{
  "devDependencies": {
    "depcheck": "1.4.3",
    "dpdm": "4.0.1",
    "@biomejs/biome": "2.3.8",
    "yaml": "2.9.1"
  },
  "scripts": {
    "fix:format:biome": "biome check --write",
    "fix:lint": "biome check --write",
    "test:format:biome": "biome format",
    "test:lint:biome": "biome check --diagnostic-level=error",
    "test:lint:biome:all": "biome check",
    "test:lint:cycles": "EXCL=$(node -p \"(require('yaml').parse(require('fs').readFileSync('.dpdmrc.yaml','utf8'))?.exclude ?? []).join('|')\") && dpdm --no-warning --no-tree --transform --exit-code circular:1 --exclude \"$EXCL\" 'src/**/!(*.test).ts'",
    "test:lint:deps": "depcheck -c ./.depcheckrc.yml",
    "test:lint": "npm run test:lint:biome && npm run test:lint:cycles && npm run test:lint:deps"
  }
}
