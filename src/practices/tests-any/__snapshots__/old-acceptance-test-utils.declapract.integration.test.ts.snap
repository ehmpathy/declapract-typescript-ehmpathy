"import { SNSEventRecord, SNSMessage, SNSEvent } from 'aws-lambda';

import { exampleEmailClickEvent } from '../../src/.test/assets/exampleEmailClickEvent';
import { runLambdaEndpoint } from 'sdk-aws-lambda';
import { sdkAwsLambdaEnvAccessContemp } from '@src/access/sdks/sdkAwsLambdaEnvAccessContemp';
import { log } from '@src/utils/logger';
import { locally } from '../environment';

describe('consumeSESEmailEventFromSNS', () => {
  it('should be possible to invoke the lambda', async () => {
    const exampleSnsEvent: SNSEvent = {
      Records: [
        {
          Sns: {
            Message: JSON.stringify(exampleEmailClickEvent),
          } as SNSMessage,
        } as SNSEventRecord,
      ],
    };
    const response = await runLambdaEndpoint.onSerialized<unknown, Record<string, any>>(
      {
        which: { service: 'svc-notifications', function: 'consumeSESEmailEventFromSNS' },
        event: exampleSnsEvent,
        at: locally ? 'local' : 'cloud',
      },
      { log, env: { access: sdkAwsLambdaEnvAccessContemp() } },
    );
    expect(response).toBeDefined();
  });
});
"
`;

