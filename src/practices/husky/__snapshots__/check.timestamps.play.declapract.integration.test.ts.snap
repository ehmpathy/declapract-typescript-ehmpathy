// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`check.timestamps guard given: [case1] a non-code file with an iso timestamp when: [t0] the guard runs then: the halt output, its instant masked, matches snapshot: check.timestamps halt output 1`] = `
"✋ ConstraintError: timestamps are forbidden in tracked files, prose and docs included. remove them, zero exceptions
   ├─ why: a timestamp is a privacy leak, and churns every diff
   └─ snapshot.json:1:{ "createdAt": "[timestamp]" }
"
`;

exports[`check.timestamps guard given: [case16] a staged file whose blob git cannot read (#681) when: [t0] the guard runs then: the fault output, the hook lines alone, matches snapshot 1`] = `
"💥 MalfunctionError: check.timestamps could not read the staged blob
   └─ notes.md
"
`;

exports[`check.timestamps guard given: [case18] a guard whose pattern grep cannot compile when: [t0] the guard runs on a clean file then: the fault output, the hook lines alone, matches snapshot 1`] = `
"💥 MalfunctionError: check.timestamps could not run its pattern; the guard is broken
   └─ notes.md (grep exit 2)
"
`;

