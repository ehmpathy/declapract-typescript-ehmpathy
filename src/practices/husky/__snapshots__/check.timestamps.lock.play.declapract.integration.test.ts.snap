exports[`check.timestamps.lock given: [case2] a repo whose timestamp hook was hand-softened with an exemption when: [t0] the input (before any apply) then: the softened hook carries the exemption, and matches snapshot: check.timestamps.sh — before 1`] = `
"#!/bin/bash

# a hand-softened timestamp hook: someone added an exemption so .goals/ commits go through
staged=$(git diff --cached --name-only --diff-filter=ACM)
while IFS= read -r file; do
  case "$file" in
    *.ts | *.sh | .goals/*) continue ;;
  esac
done <<EOF
$staged
EOF
"
`;

exports[`check.timestamps.lock given: [case2] a repo whose timestamp hook was hand-softened with an exemption when: [t1] the lock is applied, the softened hook left in place then: the lock halts with exit 2 and says revert, zero exceptions: lock halt output — on disk 1`] = `
