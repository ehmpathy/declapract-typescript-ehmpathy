exports[`repo skills given: [case9] route.concerns.dispose when: [t0] it is asked for help then: it prints the header through its last guarantee, exit 0: route.concerns.dispose — help 1`] = `
"# .what = record a disposition on many concerns of one peer reviewer,
#         in one call
#
# .why  = a lane with ten nitpicks owes ten \`route.stone.set\` calls
#         (one per concern, by contract). a shell loop is not a paved
#         command, so the driver would issue each by hand. this runs
#         the same per-concern calls, in order, and names each refusal
#
# usage:
#   rhx route.concerns.dispose --stone <stone> --with <reviewer> \\
#     [--dispute 'nitpick.1 nitpick.2' --why <fulcrum-path>] \\
#     [--concede 'nitpick.3' --severity better|urgent]
#
# guarantee:
#   - one \`rhx route.stone.set\` per concern; no --about all
#   - each dispute carries the --why fulcrum; each concede carries --severity
#   - a recorded disposition that halts the stone counts as recorded
#   - a refused call is printed with its full output to stderr
#   - exit 0 = all recorded, 2 = bad input or any refusal
"
`;

exports[`repo skills given: [case9] route.concerns.dispose when: [t1] it is given bad input then: each refusal exits 2 and names what to fix: route.concerns.dispose — refusals 1`] = `
"✋ ConstraintError: --stone and --with are required
   └─ e.g. rhx route.concerns.dispose --stone 5.3.verification --with repo-rules --concede 'nitpick.1' --severity better
✋ ConstraintError: name at least one concern via --dispute or --concede
   └─ e.g. --concede 'nitpick.1 nitpick.2' --severity better
✋ ConstraintError: --dispute needs --why <fulcrum-path>
   └─ e.g. --dispute 'nitpick.1' --why .behavior/<route>/.fulcrums/inventory.of=fulcrums.case=F1-<slug>.md
✋ ConstraintError: --concede needs --severity better|urgent, got 'meh'
   └─ e.g. --concede 'nitpick.1' --severity better (urgent only for a nameable shipped harm)
✋ ConstraintError: --severity needs a value (see --help)
✋ ConstraintError: --stone needs a value (see --help)
✋ ConstraintError: --concede needs --severity better|urgent, got ''
   └─ e.g. --concede 'nitpick.1' --severity better (urgent only for a nameable shipped harm)
✋ ConstraintError: unknown arg '--abut' (see --help)
"
`;

exports[`repo skills given: [case9] route.concerns.dispose when: [t2] it disposes three concerns, one of which is refused then: a halt counts as recorded, a refusal is named with its output, exit 2: route.concerns.dispose — one refused 1`] = `
"🐢 lets ride...

🐚 route.concerns.dispose --stone 5.3.verification --with repo-rules
   ├─ disputed: nitpick.1
   ├─ conceded (better): nitpick.2 (recorded; the stone halts until its next --as arrived)
   ├─ ✋ refused: conceded (better): nitpick.3
   └─ ✋ ConstraintError: 1 refused; each refusal's output is on stderr

🐢 bummer dude...
--- stderr
✋ ConstraintError: route.stone.set refused conceded (better): nitpick.3
   └─ ✋ ConstraintError: no concern nitpick.3 on this lane
"
`;

