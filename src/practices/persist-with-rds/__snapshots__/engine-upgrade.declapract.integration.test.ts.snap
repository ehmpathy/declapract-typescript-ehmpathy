  daos:
    to: src/access/daos
    using:
      log: src/utils/logger#log
      DatabaseConnection: src/utils/database/getOneDatabaseConnection#DatabaseConnection
  schema:
    config: codegen.sql.schema.yml
  control:
    config: provision/schema/control.yml
  code:
    config: codegen.sql.types.yml
for:
  objects:
    search:
      - 'src/domain.objects/*.ts'
    exclude:
      - 'SurfReportDraft'
"
`;

