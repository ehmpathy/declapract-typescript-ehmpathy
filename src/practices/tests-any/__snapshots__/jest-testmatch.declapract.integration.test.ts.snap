exports[`the six jest testMatch arrays given: [case1] tests-node unit when: [t0] the shipped config is read then: its match and ignore lists match snapshot, so a reviewer reads each as shipped 1`] = `
{
  "modulePathIgnorePatterns": [
    "<root>/\\.agent/(?!repo=\\.this(/|$))",
    "<root>/\\.temp/",
  ],
  "testMatch": [
    "**/*.test.ts",
    "!**/*.acceptance.test.ts",
    "!**/*.integration.test.ts",
    "!**/*.evaluation.test.ts",
    "!**/*._.acpt.test.ts",
    "!**/*._.intg.test.ts",
    "!**/*._.eval.test.ts",
    "!**/.agent/.actors/**",
    "!**/.agent/.cache/**",
    "!**/.yalc/**",
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "<root>/\\.agent/(?!repo=\\.this(/|$))",
    "<root>/\\.temp/",
  ],
}
`;

