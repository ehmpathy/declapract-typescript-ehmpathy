#!/bin/sh
# husky's runner, where `husky install` wrote it; the checks below run either way, so a checkout
# that never ran the install (a fresh worktree, where git still reads .husky/) still gates its commits
if [ -f "$(dirname -- "$0")/_/husky.sh" ]; then
  . "$(dirname -- "$0")/_/husky.sh"
fi

. "$(dirname -- "$0")/check.yalc.sh"

. "$(dirname -- "$0")/check.timestamps.lock.sh"

. "$(dirname -- "$0")/check.timestamps.sh"

. "$(dirname -- "$0")/check.secrets.sh"
