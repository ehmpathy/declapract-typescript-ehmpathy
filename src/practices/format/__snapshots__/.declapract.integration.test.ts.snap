exports[`format practice — package.json is biome only (#645) given: [case1] an adopter one release behind, on a terraform usecase when: [t0] declapract apply then: before + after of package.json match snapshot: package.json — before 1`] = `
"{
  "name": "test-project",
  "version": "1.0.0",
  "scripts": {
    "fix:format:biome": "biome check --write",
    "fix:format:terraform": "terraform fmt -recursive provision",
    "fix:format": "npm run fix:format:biome && npm run fix:format:terraform",
    "test:format:terraform": "terraform fmt -recursive -check provision",
    "test:format:biome": "biome format",
    "test:format": "npm run test:format:biome && npm run test:format:terraform"
  }
}
"
`;

