exports[`persist-with-rds config validates against config.schema.ts (#638, #683, #519) given: [case1] a fresh repo when: [t0] the configs and the schema are applied, then applied again then: the configs match snapshot: config/prep.json — after 1`] = `
"{
  "organization": "test-org",
  "project": "test-project",
  "environment": {
    "access": "prep"
  },
  "aws": {
    "account": "111111111111",
    "namespace": "testns"
  },
  "database": {
    "target": {
      "database": "testdb",
      "schema": "testdb"
    },
    "role": {
      "cicd": {
        "for-plan": {
          "username": "cicd_user",
          "password": "$.at(aws::param)"
        },
        "for-apply": {
          "username": "cicd_user",
          "password": "$.at(aws::param)"
        }
      },
      "crud": {
        "username": "service_user",
        "password": "$.at(aws::param)"
      }
    },
    "tunnel": {
      "bastion": {
        "exid": "vpc-main-bastion"
      },
      "cluster": {
        "name": "awesomesdb"
      },
      "local": {
        "host": "localhost",
        "port": 15432
      },
      "lambda": {
        "host": "awesomesdb.cluster-abc123.us-east-1.rds.amazonaws.com",
        "port": 5432
      }
    }
  }
}
"
`;

