exports[`persist-with-rds pg-pool patch given: [case4] an rds repo that already holds its own "pg-pool@3.14.0" hand patch when: [t0] the persist-with-rds practice is applied then: the before + after contents match snapshot: package.json — after 1`] = `
"{
  "name": "repo-with-hand-patch",
  "version": "1.0.0",
  "dependencies": {
    "pg": "8.3.0",
    "pg-pool": "3.14.0",
    "iso-time": "@declapract{check.minVersion('<floor>')}",
    "yesql": "@declapract{check.minVersion('<floor>')}"
  },
  "pnpm": {
    "overrides": {
      "react-refresh": "0.14.2"
    },
    "patchedDependencies": {
      "pg-pool@3.14.0": "patches/pg-pool@3.14.0.patch",
      "left-pad@1.3.0": "patches/left-pad@1.3.0.patch",
      "pg-pool": "patches/pg-pool.patch"
    }
  },
  "devDependencies": {
    "sql-code-generator": "@declapract{check.minVersion('<floor>')}",
    "sql-dao-generator": "@declapract{check.minVersion('<floor>')}",
    "sql-schema-control": "@declapract{check.minVersion('<floor>')}",
    "sql-schema-generator": "@declapract{check.minVersion('<floor>')}",
    "@types/yesql": "@declapract{check.minVersion('<floor>')}",
    "@types/pg": "@declapract{check.minVersion('<floor>')}"
  },
  "scripts": {
    "generate:dao:postgres": "sql-dao-generator generate && npm run fix:format",
    "generate:schema": "sql-schema-generator generate -c codegen.sql.schema.yml && npm run fix:format",
    "generate:types-from-sql": "sql-code-generator generate -c codegen.sql.types.yml && npm run fix:format",
    "provision:schema:plan": "sql-schema-control plan -c provision/schema/control.yml",
    "provision:schema:apply": "sql-schema-control apply -c provision/schema/control.yml",
    "provision:schema:sync": "sql-schema-control sync -c provision/schema/control.yml",
    "provision:testdb:docker:clear": "for port in $(bash provision/docker/testdb/compose.sh config --format json | jq -r '.services[].ports[]?.published'); do docker rm -f $(docker ps -a -f \\"publish=$port\\" -q) 2>/dev/null || true; done && echo 'ensured ports are available 👍'",
    "provision:testdb:docker:prepare": "cp provision/schema/sql/init/.extensions.sql provision/docker/testdb/init/extensions.sql && cp provision/schema/sql/init/.schema.sql provision/docker/testdb/init/schema.sql && cp provision/schema/sql/init/.user.cicd.sql provision/docker/testdb/init/user.cicd.sql",
    "provision:testdb:docker:up": "bash provision/docker/testdb/compose.sh up -d --force-recreate --build --renew-anon-volumes",
    "provision:testdb:docker:await": "bash provision/docker/testdb/compose.sh exec -T postgres /root/wait-for-postgres.sh",
    "provision:testdb:docker:down": "bash provision/docker/testdb/compose.sh down",
    "provision:testdb": "npm run provision:testdb:docker:clear && npm run provision:testdb:docker:prepare && npm run provision:testdb:docker:up && npm run provision:testdb:docker:await && ACCESS=test npm run provision:schema:plan && ACCESS=test npm run provision:schema:apply && ACCESS=test npm run provision:schema:plan",
    "start:testdb": "npm run provision:testdb",
    "start:livedb:prep": "rhx use.rds.capacity --env prep"
  }
}
"
`;

exports[`persist-with-rds pg-pool patch given: [case4] an rds repo that already holds its own "pg-pool@3.14.0" hand patch when: [t0] the persist-with-rds practice is applied then: the before + after contents match snapshot: package.json — before 1`] = `
