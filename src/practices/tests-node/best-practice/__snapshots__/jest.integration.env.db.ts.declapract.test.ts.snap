// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`probeTestDb given: [case1] psql fails with a real cause on stderr (a bad password) when: [t0] the preflight runs against the failed psql then: the user-faced message matches snapshot: testdb-probe failure with stderr 1`] = `
"✋ ConstraintError: cant connect to the testdb at localhost:7821
   ├─ psql said
   │     psql: error: connection to server failed:
   │     FATAL:  password authentication failed for user "svc_gateway_user"
   │
   └─ fix: psql reached the server, so the container is up; the fault is likely auth or schema
      ├─ check the crud user + password in config/test.json match what the testdb was seeded with
      ├─ check this service's schema was applied to the testdb
      ├─ check the server that answered is this repo's testdb, not another repo's on the same port (\`docker ps\` names each holder)
      └─ only if the container is in fact down, run \`npm run start:testdb\`

{
  "host": "localhost",
  "port": 7821
}"
`;

exports[`probeTestDb given: [case2.1] the psql call times out (no stderr) when: [t0] the preflight runs then: it names the timeout, and both causes: a down container, or a host too slow to answer: testdb-probe failure, psql stalled 1`] = `
"✋ ConstraintError: cant connect to the testdb at localhost:7821
   ├─ psql said
   │     (no stderr — the call timed out)
   │
   └─ fix: psql got no reply within its timeout; the container is likely down, or the host too loaded to answer
      ├─ check the testdb runs (\`docker ps\`); if it does not, run \`npm run start:testdb\`
      └─ if it runs, the host is slow: rerun once a heavy job on this host quiets

{
  "host": "localhost",
  "port": 7821
}"
`;

exports[`probeTestDb given: [case2] psql is absent from PATH when: [t0] the preflight runs then: it names the absent psql and its install, not a down container: testdb-probe failure, psql absent 1`] = `
"✋ ConstraintError: cant probe the testdb at localhost:7821, since psql is absent from PATH
   └─ fix: install the postgres client so \`psql\` is on PATH (e.g. \`apt install postgresql-client\`)

{
  "host": "localhost",
  "port": 7821
}"
`;
