// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`expo provision.yml — merge-by-job, end to end (#608) given: [case4] an expo repo with a provision.yml that holds a terraform github job and an aws job when: [t0] declapract apply then: before + after match snapshot: provision.yml — after merge 1`] = `
"name: provision

on:
  push:
    tags:
      - v*
    branches:
      - "main"
      - "master"
  pull_request:
  workflow_dispatch:

concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }} # per [workflow] x [branch, tag]
  cancel-in-progress: true #  cancel workflows for non-latest commits

permissions:
  id-token: write # required for oidc; a called workflow cannot exceed its caller's grant
  contents: read

jobs:
  # the pre-migration github job: terraform over the provision/github/ dir the migration deletes
  github:
    uses: ./.github/workflows/.declastruct.yml
    with:
      wish-path: provision/github.repo/resources.ts
      scope: github
      access: prod # github repo settings are inherently a prod resource
      github-environment-plan: production-on-else-plan
      github-environment-apply: \${{ (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')) && 'production-on-main' || 'production-on-else-apply' }} # main/tag => on-main; else => on-else-apply
      creds-github-app-owner: \${{ github.repository_owner }}
      creds-github-app-id: \${{ vars.DECLASTRUCT_GITHUB_CONFORMER_APP_ID }}
    secrets:
      creds-github-app-private-key: \${{ secrets.DECLASTRUCT_GITHUB_CONFORMER_APP_PRIVATE_KEY }}

  # the repo's own aws job, which the practice never declares
  aws:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prod
"
`;

exports[`expo provision.yml — merge-by-job, end to end (#608) given: [case4] an expo repo with a provision.yml that holds a terraform github job and an aws job when: [t0] declapract apply then: before + after match snapshot: provision.yml — before 1`] = `
"name: provision

on:
  push:
    branches:
      - "main"
  pull_request:

jobs:
  # the pre-migration github job: terraform over the provision/github/ dir the migration deletes
  github:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/github/product
      github-environment: prod

  # a second terraform job on the deleted dir, under another name
  github-environment:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/github/environment

  # the repo's own aws job, which the practice never declares
  aws:
    uses: ./.github/workflows/.terraform.yml
    with:
      working-directory: provision/aws/environments/prod
"
`;
