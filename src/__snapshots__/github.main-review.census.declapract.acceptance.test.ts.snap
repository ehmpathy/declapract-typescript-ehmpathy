// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`github.main-review.census given: [case1] a human who asks for help when: [t0] --help then: stdout matches snapshot 1`] = `
"######################################################################
# .what = census, read only: for each repo in the named owners, does
#         main require a review approval before a merge?
#
# .why  = the provision-github practice declares main's protection; a
#         census shows which repos would gain a review gate on apply.
#         the caller token often holds push, not admin, so the classic
#         protection endpoint 404s. two signals a push token can read
#         decide it instead:
#           - ruleset: an active \`pull_request\` rule on main
#           - classic: the graphql \`reviewDecision\` of the latest prs
#             into main. a gated repo never yields an empty decision
#             (unreviewed = REVIEW_REQUIRED, merged = APPROVED), so:
#               empty            → lacks
#               REVIEW_REQUIRED  → requires
#               APPROVED | CHANGES_REQUESTED → ambiguous: github sets
#               these on any reviewed pr, gate or not; read the next pr
#             proven against facebook/react (gated) and this repo
#             (ungated, yet #761 reads APPROVED)
#         an admin token reads the protection endpoint directly
#
# .note = reviewDecision describes past prs, so it lags a change of
#         the gate. a gate added after the latest pr shows only once a
#         new pr opens. after a rollout, an approved newest pr over an
#         older ungated pr reads \`lacks\`; there, trust a rerun only once
#         the latest 10 prs all postdate the gate
# .note = the tally splits each verdict by basis: \`certain\` (ruleset,
#         protection endpoint, or main unprotected) vs \`inferred\` (the
#         reviewDecision of a pr)
#
# usage:
#   rhx github.main-review.census
#   rhx github.main-review.census --owners 'ehmpathy ahbode'
#
# options:
#   --owners   space-separated orgs or users, never comma-separated
#              (default: 'ehmpathy ahbode whodisio uladkasach')
#
# guarantee:
#   - every github call is a read: rest GETs (\`--method GET\`) plus two
#     graphql queries (\`gh pr list\`, \`gh repo list\`); it writes naught
#   - skips archived repos and forks (counted, not listed)
#   - prints each owner's repo count as it walks; an owner with 0 repos
#     visible, or at the list cap, fails loud, never an undercount
#   - verdict per repo: requires | lacks | unknown (no main branch | no decisive pr)
#   - full table kept in .log/github.main-review.census/census.md; each
#     run replaces it, so a run scoped by --owners holds only those owners
#   - each run reads into its own scratch dir; the table and rows land
#     by a plain copy at the end, so run one census at a time
#   - exit 0 = census done, 1 = a github read failed, 2 = bad input
######################################################################
"
`;

exports[`github.main-review.census given: [case2] a human who mistypes an arg when: [t0] an unknown arg, --owners with no value, then an empty --owners then: stderr of --owners with no value matches snapshot 1`] = `
"✋ ConstraintError: --owners needs a value
   └─ fix: name the owners, e.g. rhx github.main-review.census --owners 'ehmpathy ahbode'
"
`;

exports[`github.main-review.census given: [case2] a human who mistypes an arg when: [t0] an unknown arg, --owners with no value, then an empty --owners then: stderr of the empty --owners matches snapshot 1`] = `
"✋ ConstraintError: --owners is empty
   └─ fix: name the owners, e.g. rhx github.main-review.census --owners 'ehmpathy ahbode'
"
`;

exports[`github.main-review.census given: [case2] a human who mistypes an arg when: [t0] an unknown arg, --owners with no value, then an empty --owners then: stderr of the unknown arg matches snapshot 1`] = `
"✋ ConstraintError: unknown arg '--nope'
   └─ fix: see the flags via rhx github.main-review.census --help
"
`;

exports[`github.main-review.census given: [case3] the real gh cli, with no github credentials when: [t0] the census runs then: stderr, with the cause masked, matches snapshot 1`] = `
"💥 MalfunctionError: could not list repos for 'ehmpathy'
   ├─ cause: [gh: no credentials]
   └─ fix: log gh in (gh auth login) or set GH_TOKEN, then rerun
"
`;

exports[`github.main-review.census given: [case3] the real gh cli, with no github credentials when: [t0] the census runs then: stdout, cut short before any owner line, matches snapshot 1`] = `
