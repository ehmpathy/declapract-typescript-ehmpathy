exports[`persist-with-rds engine upgrade surface (#664) given: [case3] check-engine-skew.sh when: [t0] the testdb leads the livedb then: the check lines match the snapshot 1`] = `
{
  "status": 2,
  "stderr": "✋ ConstraintError: the testdb (postgres 17) leads the livedb (postgres 13)
   ├─ why: a green suite here can rest on a postgres 17 feature the livedb rejects
   └─ fix: one of two, by how the skew arrived
      ├─ the pin moved before the flip: merge after the livedb reads postgres 17
      └─ the livedb fell back:          pin the testdb to postgres 13 until the flip holds",
  "stdout": "🔭 engine skew
   ├─ testdb: postgres 17 (<dockerfile>)
   └─ livedb: postgres 13.23
",
}
`;

exports[`persist-with-rds engine upgrade surface (#664) given: [case3] check-engine-skew.sh when: [t1] the testdb leads a livedb below its declared target then: the check lines match the snapshot 1`] = `
{
  "status": 2,
  "stderr": "✋ ConstraintError: the testdb (postgres 17) leads the livedb (postgres 13)
   ├─ why: a green suite here can rest on a postgres 17 feature the livedb rejects
   ├─ how: the livedb sits below its declared target 17 — a flip was reverted, or has not yet applied
   └─ fix: pin the testdb to postgres 13 until the flip holds. do not re-flip a reverted livedb from here",
  "stdout": "🔭 engine skew
   ├─ testdb: postgres 17 (<dockerfile>)
   └─ livedb: postgres 13.23
",
}
`;

