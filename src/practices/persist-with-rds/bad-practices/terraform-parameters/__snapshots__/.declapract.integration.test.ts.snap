// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`terraform-parameters forget given: [case1] a repo with terraform-managed ssm params when: [t0] the migration input (before any fix) then: the terraform input matches snapshot: parameter-store.tf — before 1`] = `
"data "aws_ssm_parameter" "legacy_admin_password" {
  name            = "\${local.parameter_store_namespace}.database.admin.password"
  count           = var.environment == "prod" ? 1 : 0
  with_decryption = true
}
resource "aws_ssm_parameter" "secret_database_role_crud_password" {
  name  = "\${local.parameter_store_namespace}.database.role.crud.password"
  type  = "SecureString"
  value = "__IGNORED__"
  tags  = local.tags
  lifecycle {
    ignore_changes = [value]
  }
}
resource "aws_ssm_parameter" "secret_twilio_authToken" {
  name  = "\${local.parameter_store_namespace}.twilio.authToken"
  type  = "SecureString"
  value = "__IGNORED__"
  tags  = local.tags
  lifecycle {
    ignore_changes = [value]
  }
}
"
`;

exports[`terraform-parameters forget given: [case1] a repo with terraform-managed ssm params when: [t1] the bad-practice forget fix is applied then: the terraform file holds only removed{} forget blocks (no resource/data blocks) and matches snapshot: parameter-store.tf — after 1`] = `
"removed {
  from = aws_ssm_parameter.secret_database_role_crud_password
  lifecycle {
    destroy = false # forget from state; keep the live param
  }
}
removed {
  from = aws_ssm_parameter.secret_twilio_authToken
  lifecycle {
    destroy = false # forget from state; keep the live param
  }
}
"
`;
