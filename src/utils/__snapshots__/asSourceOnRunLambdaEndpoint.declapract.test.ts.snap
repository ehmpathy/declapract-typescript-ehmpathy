exports[`asSourceOnRunLambdaEndpoint given: [case1] a blackbox acceptance test on invokeLambdaForTesting when: [t0] it is moved then: the output matches snapshot 1`] = `
"import { asLambdaEvent, runLambdaEndpoint } from 'sdk-aws-lambda';
import { sdkAwsLambdaEnvAccessContemp } from '@src/access/sdks/sdkAwsLambdaEnvAccessContemp';
import { log } from '@src/utils/logger';
import { given, then, when } from 'test-fns';

import { locally } from '../environment';

describe('getWidget', () => {
  given('a widget', () => {
    when('asked by uuid', () => {
      then('it responds', async () => {
        const response = await runLambdaEndpoint.onSerialized<unknown, Record<string, any>>(
          {
            which: { service: 'svc-widgets', function: 'getWidget' },
            event: { widgetUuid: 'w-1' },
            at: locally ? 'local' : 'cloud',
          },
          { log, env: { access: sdkAwsLambdaEnvAccessContemp() } },
        );
        expect(response.widget).toBeDefined();
      });
    });
    when('asked over the gateway', () => {
      then('it responds', async () => {
        const response = await runLambdaEndpoint.onSerialized<unknown, Record<string, any>>(
          {
            which: { service: 'svc-widgets', function: 'getWidgetPublic' },
            event: asLambdaEvent.fromApiGateway({
              httpMethod: 'POST',
              body: JSON.stringify({ widgetUuid: 'w-1' }),
            }),
            at: 'cloud',
          },
          { log, env: { access: sdkAwsLambdaEnvAccessContemp() } },
        );
        expect(response.statusCode).toEqual(200);
      });
    });
  });
});
"
`;

exports[`asSourceOnRunLambdaEndpoint given: [case2] an integration test on invokeHandlerForTesting when: [t0] it is moved then: the output matches snapshot 1`] = `
"import { asLambdaEndpointOutput, runLambdaEndpoint } from 'sdk-aws-lambda';
import { getError } from 'test-fns';

import { handler } from './getWidget';

describe('getWidget', () => {
  it('responds', async () => {
    const response = await runLambdaEndpoint.onReferenced({ event: { widgetUuid: 'w-1' }, handler }).then(asLambdaEndpointOutput);
    expect(response).toBeDefined();
  });
  it('rejects a blank uuid', async () => {
    const error = await getError(runLambdaEndpoint.onReferenced({ event: { widgetUuid: '' }, handler }).then(asLambdaEndpointOutput));
    expect(error).toBeDefined();
  });
});
"
`;

