exports[`sdk-aws-lambda-pre-v07 src given: [case1] an ask handler on the bare genLambdaEndpoint call when: [t1] fix then: the output matches snapshot 1`] = `
"import { genLambdaEndpoint } from 'sdk-aws-lambda';
import { z } from 'zod';

import { log } from '@src/utils/logger';

export const handler = genLambdaEndpoint.forAsk(
  {
    schema: { input: z.object({ widgetId: z.string() }), output: z.object({ ok: z.boolean() }) },
    invoke: async ({ payload }, context) => {
      const found = await getWidget({ widgetId: payload.widgetId }, context);
      return { ok: !!found, echo: { event: payload } };
    },
  },
  { log },
);
"
`;

