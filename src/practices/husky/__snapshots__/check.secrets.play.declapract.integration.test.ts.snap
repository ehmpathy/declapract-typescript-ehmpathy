// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`check.secrets guard given: [case1] a staged debug file that holds a fireworks key (the #514 incident) when: [t0] the guard runs then: the halt output matches snapshot: check.secrets halt output 1`] = `
"✋ ConstraintError: a secret key shape is staged
   ├─ shape: fireworks key
   ├─ file: .cache/debug.env:2
   └─ fix: remove it, and rotate the key if it ever left this machine
"
`;

exports[`check.secrets guard given: [case2] the halt table — each key shape the guard knows when: [t0] the guard runs on a anthropic key then: the halt output matches snapshot: check.secrets halt output — anthropic key 1`] = `
"✋ ConstraintError: a secret key shape is staged
   ├─ shape: anthropic key
   ├─ file: config.md:1
   └─ fix: remove it, and rotate the key if it ever left this machine
"
`;

exports[`check.secrets guard given: [case5] git cannot list the staged files (#802) when: [t0] the guard runs outside a git repo then: it halts as a malfunction (exit 1) that names the failed step, never passes: check.secrets malfunction — staged list 1`] = `
"💥 MalfunctionError: check.secrets could not list the staged files
   ├─ why: a failed read or scan halts the commit, never reads as clean
   └─ fix: repair git (git status names the fault), then commit again
"
`;

exports[`check.secrets guard given: [case6] the scan itself faults (#789) when: [t0] the guard runs with a grep that exits 2 then: it halts as a malfunction (exit 1), never reads the fault as clean: check.secrets malfunction — scan 1`] = `
"💥 MalfunctionError: check.secrets could not scan for the aws access key id shape
   ├─ file: readme.md
   ├─ why: a failed read or scan halts the commit, never reads as clean
   └─ fix: repair grep (its own words print above), then commit again
"
`;

exports[`check.secrets guard given: [case7] a staged file whose blob git cannot read (#802) when: [t0] the guard runs then: it halts as a malfunction (exit 1) that names the file, never reads the blob as clean: check.secrets malfunction — staged blob 1`] = `
"💥 MalfunctionError: check.secrets could not read the staged blob
   ├─ file: notes.md
   ├─ why: a failed read or scan halts the commit, never reads as clean
   └─ fix: repair git (git status names the fault), then commit again
"
`;

exports[`check.secrets guard given: [case8] a moved file, edited to hold a key, staged as a rename when: [t0] the guard runs then: it halts with exit 2 and names the moved file and the line, never the key: check.secrets halt output — rename 1`] = `
"✋ ConstraintError: a secret key shape is staged
   ├─ shape: anthropic key
   ├─ file: moved.md:41
   └─ fix: remove it, and rotate the key if it ever left this machine
"
`;
