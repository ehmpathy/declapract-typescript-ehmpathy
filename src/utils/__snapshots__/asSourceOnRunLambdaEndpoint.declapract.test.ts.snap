    const error = await axios.post(url, {}).catch((caught) => caught);
    // @declapract:review: declapract-typescript-ehmpathy#650 — if this reads a runLambdaEndpoint result, it is now \`error.message\` / \`error.class\` on sdk-aws-lambda >= 0.7.2; an http response stays flat
